# Shared by scripts/demo/record.sh and scripts/demo/seed.sh. Values only: no keys.
RIVELL_DEV_USER_ID=00000000-0000-0000-0000-000000000001
RIVELL_DEV_ORGANIZATION_ID=00000000-0000-0000-0000-000000000002
RIVELL_DEV_ROLES=ADMIN
RIVELL_INTELLIGENCE_PROVIDER=jev
TYPESAFE_MODEL=jev-1.13.0
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_ENABLED=true
RIVELL_EMBEDDINGS_PROVIDER=openai-compatible
RIVELL_EMBEDDINGS_MODEL=text-embedding-3-small
# dimensions unset on purpose: the probe ran without them, so the frozen identity is
# openai-compatible:text-embedding-3-small in both the record run and every replay.
RIVELL_JOB_WORKER_ENABLED=true
JOBRUNR_BACKGROUNDJOBSERVER_POLLINTERVALINSECONDS=5
RIVELL_RETRIEVAL_INDEXING_ENABLED=true
RIVELL_RETRIEVAL_RECONCILIATION_CRON=
RIVELL_ORDER_PROBE=off
RIVELL_REVIEW_OMISSIONS=false
RIVELL_REVIEW_DEFINITIONS=false
