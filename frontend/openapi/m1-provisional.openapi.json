{
  "openapi": "3.1.0",
  "info": {
    "title": "RedStar Backend API (M1 PROVISIONAL FIXTURE)",
    "description": "TEMPORARY: system status (from backend snapshot) + M1 contract endpoints derived from docs/engineering/backend/specs/2026-09-22-m1-immutable-document-canonical-structure.md. Replace with backend-generated openapi.json at M1 integration checkpoint; delete this file then.",
    "version": "v1-m1-provisional"
  },
  "servers": [{ "url": "http://localhost", "description": "Generated server url" }],
  "paths": {
    "/api/system/status": {
      "get": {
        "tags": ["system-status-controller"],
        "operationId": "status",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SystemStatusResponse" }
              }
            }
          }
        }
      }
    },
    "/api/contracts": {
      "post": {
        "tags": ["contract-controller"],
        "operationId": "createContract",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contract created and parsed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContractSummary" }
              }
            }
          },
          "400": { "description": "Invalid upload" }
        }
      }
    },
    "/api/contracts/{contractId}": {
      "get": {
        "tags": ["contract-controller"],
        "operationId": "getContract",
        "parameters": [
          {
            "name": "contractId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContractSummary" }
              }
            }
          },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/contracts/{contractId}/versions/{versionNumber}/structure": {
      "get": {
        "tags": ["contract-controller"],
        "operationId": "getContractStructure",
        "parameters": [
          {
            "name": "contractId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "versionNumber",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StructureResponse" }
              }
            }
          },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/contracts/{contractId}/versions/{versionNumber}/original": {
      "get": {
        "tags": ["contract-controller"],
        "operationId": "downloadOriginal",
        "parameters": [
          {
            "name": "contractId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "versionNumber",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Original DOCX bytes",
            "content": {
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "404": { "description": "Not found" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SystemStatusResponse": {
        "type": "object",
        "properties": {
          "service": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "SourceSpan": {
        "type": "object",
        "required": ["partPath", "bodyIndex"],
        "properties": {
          "partPath": { "type": "string" },
          "bodyIndex": { "type": "integer" },
          "paragraphIndex": { "type": ["integer", "null"] },
          "tableIndex": { "type": ["integer", "null"] },
          "rowIndex": { "type": ["integer", "null"] },
          "cellIndex": { "type": ["integer", "null"] },
          "runStart": { "type": ["integer", "null"] },
          "runEnd": { "type": ["integer", "null"] }
        }
      },
      "DocumentNode": {
        "type": "object",
        "required": [
          "id",
          "parentId",
          "nodeType",
          "ordinal",
          "text",
          "headingLevel",
          "rawStyleId",
          "sourceSpan"
        ],
        "properties": {
          "id": { "type": "string" },
          "parentId": { "type": ["string", "null"] },
          "nodeType": {
            "type": "string",
            "enum": [
              "TITLE",
              "HEADING",
              "PARAGRAPH",
              "TABLE",
              "TABLE_ROW",
              "TABLE_CELL",
              "BODY"
            ]
          },
          "ordinal": { "type": "integer" },
          "text": { "type": ["string", "null"] },
          "headingLevel": { "type": ["integer", "null"] },
          "rawStyleId": { "type": ["string", "null"] },
          "sourceSpan": { "$ref": "#/components/schemas/SourceSpan" }
        }
      },
      "ContractSummary": {
        "type": "object",
        "required": [
          "contractId",
          "filename",
          "versionNumber",
          "parseStatus"
        ],
        "properties": {
          "contractId": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "filename": { "type": "string" },
          "versionNumber": { "type": "integer", "minimum": 1 },
          "parseStatus": { "type": "string" },
          "parseQuality": { "type": ["string", "null"] },
          "parserVersion": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"] },
          "warnings": {
            "type": "array",
            "items": { "type": "string" }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "StructureResponse": {
        "type": "object",
        "required": [
          "contractId",
          "versionNumber",
          "parserVersion",
          "parseStatus",
          "parseQuality",
          "warnings",
          "nodes"
        ],
        "properties": {
          "contractId": { "type": "string" },
          "versionNumber": { "type": "integer", "minimum": 1 },
          "parserVersion": { "type": "string" },
          "parseStatus": { "type": "string" },
          "parseQuality": { "type": "string" },
          "warnings": {
            "type": "array",
            "items": { "type": "string" }
          },
          "nodes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DocumentNode" }
          }
        }
      }
    }
  }
}
