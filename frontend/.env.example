# Path or URL to the OpenAPI document used for type generation.
# M1 default: temporary provisional fixture (system status + M1 contract endpoints).
# At M1 integration checkpoint, regenerate from backend and flip default back:
#   OPENAPI_SCHEMA=/Users/shridhar600/Dev/Projects/RedStar-backend-m0/backend/target/openapi/openapi.json npm run generate:api
#   then restore package.json default to ./openapi/openapi.json and delete openapi/m1-provisional.openapi.json
OPENAPI_SCHEMA=./openapi/m1-provisional.openapi.json

# Base URL for the typed API client (Vite-exposed).
VITE_API_BASE_URL=http://localhost:8080
