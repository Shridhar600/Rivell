# Path or URL to the OpenAPI document used for type generation.
OPENAPI_SCHEMA=./openapi/openapi.json

# Backend target for the Vite dev/preview /api proxy.
VITE_API_PROXY_TARGET=http://localhost:8080

# Base URL for the typed API client (Vite-exposed).
# Leave empty to use the application origin; in development the /api proxy forwards to
# VITE_API_PROXY_TARGET. Set an absolute URL only when the API is served from another origin.
VITE_API_BASE_URL=
