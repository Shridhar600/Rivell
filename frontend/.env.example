# Path or URL to the authoritative OpenAPI document.
# Default: snapshot of backend-generated contract (openapi/openapi.json).
# Refresh from backend after OpenAPI regeneration, e.g.:
# OPENAPI_SCHEMA=/Users/shridhar600/Dev/Projects/RedStar-backend-m0/backend/target/openapi/openapi.json
OPENAPI_SCHEMA=./openapi/openapi.json

# Base URL for the typed API client (Vite-exposed).
VITE_API_BASE_URL=http://localhost:8080
